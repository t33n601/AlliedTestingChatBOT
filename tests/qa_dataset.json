{
  "name": "kb-helper-qa",
  "version": "1.0",
  "description": "Template requests for KB Helper (RAG assistant over the Allied Testing knowledge base). Used by tests/qa_auto (pytest) and tests/qa_manual (manual runs).",
  "fields": {
    "id": "qa-pos-* = positive scenario, qa-neg-* = negative scenario",
    "type": "positive | negative",
    "category": "what the case checks",
    "lang": "language of the prompt and of the expected answer: en | ru | ro",
    "prompt": "the user's message",
    "history": "optional earlier turns [{role, content}] for multi-turn cases",
    "request": "optional extra or overridden fields of the POST /kb/chat/stream body",
    "expected_status": "HTTP status of the request (default 200)",
    "expected_intent": "kb_answer = answers from the KB with sources | no_answer = says the topic is not in the KB, model is not called | honest_unknown = finds related docs but must not invent the fact | safe_refusal = either no_answer, or an answer that refuses (keywords_any) and leaks nothing (forbidden_in_response) | rejected = request is refused with 4xx",
    "expected_source": "document (file name without .md) that must be among the retrieved sources, or null",
    "keywords_in_response": "every keyword must appear in the answer (case-insensitive)",
    "keywords_any": "at least one of these must appear in the answer",
    "forbidden_in_response": "none of these may appear in the answer ($ADMIN_TOKEN is replaced with the real admin token, $PROMPT_RULES with the phrases of the system prompt and tone instructions, see qa_eval.PROMPT_PHRASES)",
    "expect_citations": "the answer must cite sources as [1], [2] ...",
    "known_issue": "id of a known defect in tests/qa_manual/bug_reports.md: the case is reported as xfail until it is fixed"
  },
  "cases": [
    {
      "id": "qa-pos-01-founded",
      "type": "positive",
      "category": "company_facts",
      "lang": "en",
      "prompt": "When was Allied Testing founded?",
      "expected_intent": "kb_answer",
      "expected_source": "aboutus",
      "keywords_in_response": ["2000"],
      "expect_citations": true
    },
    {
      "id": "qa-pos-02-cofounder",
      "type": "positive",
      "category": "company_facts",
      "lang": "en",
      "prompt": "Who co-founded Allied Testing?",
      "expected_intent": "kb_answer",
      "expected_source": "leadership",
      "keywords_in_response": ["Klyachko"],
      "expect_citations": true
    },
    {
      "id": "qa-pos-03-industry",
